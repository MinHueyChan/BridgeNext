# Set via Replit-managed integration / Secrets, never in source.
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
# Optional compatible model override, kept server-side.
GEMINI_MODEL=gemini-2.5-flash
# Set true for a React build hosted by FastAPI. Private Sites preview uses false.
VITE_BACKEND_ENABLED=false
PORT=5000
